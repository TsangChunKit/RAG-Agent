{
  "permissions": {
    "allow": [
      "Read(//opt/homebrew/bin/**)",
      "Read(//usr/local/bin/**)",
      "Bash(brew --version)",
      "Bash(pyenv versions *)",
      "Bash(/Users/andytsang/.local/bin/python3.11 --version)",
      "Bash(/Users/andytsang/.local/bin/python3.11 -m pip --version)",
      "WebSearch",
      "Bash(cat private.nosync/gemini_settings.json)",
      "Bash(rm -f private.nosync/gemini_settings.json)",
      "Bash(launchctl bootout *)",
      "Bash(launchctl bootstrap *)",
      "Bash(curl -s http://localhost:8501/_stcore/health)",
      "Read(//private/tmp/**)",
      "Bash(bash scripts/counseling_agent_ctl.sh status)",
      "Bash(tailscale ip *)",
      "Bash(echo \"exit=$?\")",
      "Bash(tailscale status *)",
      "Bash(curl -s -m 5 -o /dev/null -w \"%{http_code}\\\\n\" http://100.64.84.111:8501/_stcore/health)",
      "Bash(open -a Tailscale)",
      "Bash(tailscale up *)",
      "Bash(curl -s -m 5 -o /dev/null -w \"tailscale 网页: %{http_code}\\\\n\" http://100.64.84.111:8501/_stcore/health)",
      "Bash(gh auth *)",
      "Bash(git config *)",
      "Bash(git init *)",
      "Bash(git add *)",
      "Bash(git check-ignore *)",
      "Bash(git commit -q -m ' *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(gh repo *)",
      "Bash(gh *)",
      "Bash(python3 *)",
      "Bash(python *)",
      "Bash(awk '{print $NF}')",
      "Bash(grep -E \"\\\\.\\(py|sh\\)$\")",
      "Bash(xargs -I {} basename {})",
      "Read(//Users/andytsang/Documents/Project/**)",
      "Bash(cp -r \"心理咨詢agent\" \"RAG-Agent\")",
      "Bash(*)",
      "WebFetch(domain:github.com)",
      "Bash(cp ~/.claude/settings.json ~/.claude/settings.json.bak)",
      "Read(//Users/andytsang/.claude/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && if ! git diff-index --quiet HEAD -- 2>/dev/null; then git add -A && git commit -m \"chore: auto checkpoint after session\" && git push 2>/dev/null || true; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); cmd=$(printf '%s' \"$input\" | jq -r '.tool_input.command // empty'); if printf '%s' \"$cmd\" | grep -qE 'git (commit|push)'; then (lsof -ti:8502 | xargs kill 2>/dev/null; sleep 1; cd /Users/andytsang/Documents/Project/RAG-Agent && nohup .venv/bin/streamlit run app.py --server.port=8502 --server.headless=true >/tmp/streamlit_ragagent.log 2>&1 & disown); echo \"$(date): restarted streamlit (8502) after git commit/push\" >> /tmp/streamlit_ragagent_restart.log; fi",
            "statusMessage": "Restarting Streamlit (8502) after git commit/push…"
          }
        ]
      }
    ]
  }
}
