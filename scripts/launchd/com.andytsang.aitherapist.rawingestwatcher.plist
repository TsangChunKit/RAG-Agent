<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.andytsang.aitherapist.rawingestwatcher</string>
    <!-- ⚠️ 必须显式传 workspace 参数：本进程不是 Streamlit，拿不到 UI 的 session_state，
         不传就会退到「workspaces/ 下字母序第一个」，将来新建一个名字更靠前的 workspace
         会悄悄改掉扫描目标。 -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/andytsang/Documents/Project/RAG-Agent/.venv/bin/python3</string>
        <string>-m</string>
        <string>scripts.raw_ingest_watcher</string>
        <string>--workspace</string>
        <string>counseling</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/andytsang/Documents/Project/RAG-Agent</string>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- 新文件摘要会调用当前 LLM provider；launchd 默认 PATH 不含 Homebrew。 -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/tmp/raw_ingest_watcher.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/raw_ingest_watcher.log</string>
</dict>
</plist>
