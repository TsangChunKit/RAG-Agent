<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.andytsang.aitherapist.streamlit</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/andytsang/Documents/Project/RAG-Agent/.venv/bin/python3</string>
        <string>-m</string>
        <string>streamlit</string>
        <string>run</string>
        <string>app.py</string>
        <string>--server.headless</string>
        <string>true</string>
        <string>--server.port</string>
        <string>8502</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/andytsang/Documents/Project/RAG-Agent</string>
    <!-- 侧边栏的 Workspace 选择器会写 session_state 覆盖它；这个只是「还没选过时」的初始默认，
         免得靠 workspaces/ 的字母序兜底。 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>CURRENT_WORKSPACE</key>
        <string>counseling</string>
        <!-- launchd 默认 PATH 不含 Homebrew；copilot_cli provider 需要找到本机 copilot。 -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/tmp/streamlit.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/streamlit.log</string>
</dict>
</plist>
