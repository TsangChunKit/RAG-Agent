<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.andytsang.aitherapist.wakegateway</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/andytsang/Documents/Project/RAG-Agent/.venv/bin/python3</string>
        <string>-m</string>
        <string>scripts.streamlit_wake_server</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/andytsang/Documents/Project/RAG-Agent</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>RAG_WAKE_HOST</key>
        <string>0.0.0.0</string>
        <key>RAG_WAKE_PORT</key>
        <string>8501</string>
        <key>RAG_STREAMLIT_HOST</key>
        <string>127.0.0.1</string>
        <key>RAG_STREAMLIT_PORT</key>
        <string>8502</string>
