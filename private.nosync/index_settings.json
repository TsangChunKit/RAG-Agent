{
  "retrieval": {
    "top_k": 8,
    "window_expand": 1
  },
  "chunking": {
    "chunk_size": 400,
    "chunk_overlap": 65
  },
  "embedding": {
    "model": "BAAI/bge-m3",
    "device": "mps",
    "batch_size": 256,
    "use_fp16": true
  },
  "fts": {
    "base_tokenizer": "jieba/default",
    "ngram_min": 2,
    "ngram_max": 3
  },
  "reranker": {
    "use_reranker": true,
    "rerank_top_k": 30,
    "final_top_k": 10,
    "min_score": 0.2,
    "min_keep": 4,
    "model": "BAAI/bge-reranker-v2-m3",
    "device": "mps",
    "use_fp16": true
  },
  "graph_evidence": {
    "max_dates": 5,
    "fragments_per_date": 3,
    "window_expand": 1,
    "include_summary": true
  }
}